<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.dino.presentation.controllers.StartMenuController"
            stylesheets="@start_menu.css"
            style="-fx-background-color: #0a1520;">
    <center>
        <!-- Contenedor principal centrado verticalmente -->
        <HBox spacing="0" alignment="CENTER" style="-fx-padding: 36 52;">

            <!-- ══ Panel izquierdo: identidad + instrucciones ══ -->
            <VBox spacing="18" prefWidth="440"
                  style="-fx-background-color: #0f1e2e;
                         -fx-background-radius: 22 0 0 22;
                         -fx-border-radius: 22 0 0 22;
                         -fx-border-color: rgba(0,229,255,0.15);
                         -fx-border-width: 1.5 0 1.5 1.5;
                         -fx-padding: 30 22 30 28;">

                <!-- Título principal -->
                <VBox spacing="5">
                    <Label text="THREADED"
                           style="-fx-font-size: 62px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #00e5ff;
                                  -fx-font-family: 'Monospaced';
                                  -fx-effect: dropshadow(gaussian, rgba(0,229,255,0.30), 22, 0, 0, 2);"/>
                    <Label text="co-op  ·  UDP  ·  host autoritativo"
                           style="-fx-font-size: 11.5px;
                                  -fx-text-fill: #c8e8f0;
                                  -fx-font-family: 'Monospaced';
                                  -fx-opacity: 0.82;
                                  -fx-padding: 0 0 0 3;"/>
                </VBox>

                <Label text="Muévanse juntos, tensen la cuerda con cuidado y lleguen en equipo a cada salida."
                       wrapText="true"
                       style="-fx-font-size: 12px;
                              -fx-text-fill: #E8F4F8;
                              -fx-font-family: 'Monospaced';
                              -fx-line-spacing: 2;"/>

                <!-- Cómo se juega -->
                <VBox spacing="9"
                      style="-fx-background-color: rgba(8,18,30,0.95);
                             -fx-background-radius: 14;
                             -fx-border-radius: 14;
                             -fx-border-color: rgba(0,229,255,0.18);
                             -fx-border-width: 1;
                             -fx-padding: 14 16;">
                    <Label text="// CÓMO SE JUEGA"
                           style="-fx-text-fill: #00e5ff;
                                  -fx-font-size: 9.5px;
                                  -fx-font-weight: bold;
                                  -fx-font-family: 'Monospaced';
                                  -fx-padding: 0 0 3 0;"/>
                    <HBox spacing="10" alignment="TOP_LEFT">
                        <Label text="01" minWidth="20"
                               style="-fx-text-fill: #00e5ff; -fx-font-size: 9.5px; -fx-font-weight: bold; -fx-font-family: 'Monospaced';"/>
                        <Label text="Todos unidos por un hilo virtual — alejarse demasiado arrastra o frena al grupo."
                               wrapText="true" maxWidth="350"
                               style="-fx-text-fill: #E8F4F8; -fx-font-size: 11px; -fx-font-family: 'Monospaced';"/>
                    </HBox>
                    <HBox spacing="10" alignment="TOP_LEFT">
                        <Label text="02" minWidth="20"
                               style="-fx-text-fill: #00e5ff; -fx-font-size: 9.5px; -fx-font-weight: bold; -fx-font-family: 'Monospaced';"/>
                        <Label text="Si el hilo se tensa demasiado, arrastrará o frenará a los jugadores."
                               wrapText="true" maxWidth="350"
                               style="-fx-text-fill: #E8F4F8; -fx-font-size: 11px; -fx-font-family: 'Monospaced';"/>
                    </HBox>
                    <HBox spacing="10" alignment="TOP_LEFT">
                        <Label text="03" minWidth="20"
                               style="-fx-text-fill: #00e5ff; -fx-font-size: 9.5px; -fx-font-weight: bold; -fx-font-family: 'Monospaced';"/>
                        <Label text="Un jugador cae → toda la sala se reinicia."
                               wrapText="true" maxWidth="350"
                               style="-fx-text-fill: #E8F4F8; -fx-font-size: 11px; -fx-font-family: 'Monospaced';"/>
                    </HBox>
                    <HBox spacing="10" alignment="TOP_LEFT">
                        <Label text="04" minWidth="20"
                               style="-fx-text-fill: #00e5ff; -fx-font-size: 9.5px; -fx-font-weight: bold; -fx-font-family: 'Monospaced';"/>
                        <Label text="Todos deben llegar a la salida para completar el nivel."
                               wrapText="true" maxWidth="350"
                               style="-fx-text-fill: #E8F4F8; -fx-font-size: 11px; -fx-font-family: 'Monospaced';"/>
                    </HBox>
                    <HBox spacing="10" alignment="TOP_LEFT">
                        <Label text="05" minWidth="20"
                               style="-fx-text-fill: #00e5ff; -fx-font-size: 9.5px; -fx-font-weight: bold; -fx-font-family: 'Monospaced';"/>
                        <Label text="Usen cajas y apílense para alcanzar zonas altas."
                               wrapText="true" maxWidth="350"
                               style="-fx-text-fill: #E8F4F8; -fx-font-size: 11px; -fx-font-family: 'Monospaced';"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- ── Separador vertical ── -->
            <Region minWidth="1" maxWidth="1" prefWidth="1"
                    style="-fx-background-color: rgba(0,229,255,0.12); -fx-min-height: 420;"/>

            <!-- ══ Panel derecho: formulario ══ -->
            <VBox spacing="16" prefWidth="450"
                  style="-fx-background-color: #0f1e2e;
                         -fx-background-radius: 0 22 22 0;
                         -fx-border-radius: 0 22 22 0;
                         -fx-border-color: rgba(0,229,255,0.15);
                         -fx-border-width: 1.5 1.5 1.5 0;
                         -fx-padding: 30 28 30 22;">

                <!-- Encabezado de sección -->
                <VBox spacing="3">
                    <Label text="// CONFIGURAR SESIÓN"
                           style="-fx-text-fill: #00e5ff;
                                  -fx-font-size: 9.5px;
                                  -fx-font-weight: bold;
                                  -fx-font-family: 'Monospaced';"/>
                    <Label text="Nueva partida o unirse a una sala existente."
                           style="-fx-text-fill: #7a9ab4;
                                  -fx-font-size: 11px;
                                  -fx-font-family: 'Monospaced';"/>
                </VBox>

                <!-- Nombre del jugador -->
                <VBox spacing="5">
                    <Label text="NOMBRE DEL JUGADOR"
                           style="-fx-text-fill: #E8F4F8;
                                  -fx-font-size: 9.5px;
                                  -fx-font-weight: bold;
                                  -fx-font-family: 'Monospaced';"/>
                    <TextField fx:id="playerNameField"
                               promptText="identificador de red"
                               styleClass="field-std"/>
                </VBox>

                <!-- Modo host / cliente -->
                <HBox spacing="24" alignment="CENTER_LEFT">
                    <RadioButton fx:id="createRadio"
                                 text="CREAR SALA"
                                 styleClass="mode-radio"
                                 selected="true">
                        <toggleGroup>
                            <ToggleGroup fx:id="modeToggle"/>
                        </toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="joinRadio"
                                 text="UNIRSE"
                                 styleClass="mode-radio">
                        <toggleGroup>
                            <fx:reference source="modeToggle"/>
                        </toggleGroup>
                    </RadioButton>
                </HBox>

                <!-- Campos de red -->
                <GridPane hgap="12" vgap="9">
                    <columnConstraints>
                        <ColumnConstraints minWidth="115" prefWidth="125"/>
                        <ColumnConstraints minWidth="200" prefWidth="260" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="IP LOCAL"
                           style="-fx-text-fill: #E8F4F8; -fx-font-size: 9.5px; -fx-font-weight: bold; -fx-font-family: 'Monospaced';"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="localIpField" text="0.0.0.0" styleClass="field-std"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="PUERTO LOCAL"
                           style="-fx-text-fill: #E8F4F8; -fx-font-size: 9.5px; -fx-font-weight: bold; -fx-font-family: 'Monospaced';"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="localPortField" text="5000" styleClass="field-std"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="IP HOST"
                           style="-fx-text-fill: #E8F4F8; -fx-font-size: 9.5px; -fx-font-weight: bold; -fx-font-family: 'Monospaced';"
                           GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="hostIpField" promptText="192.168.x.x" styleClass="field-std"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="PUERTO HOST"
                           style="-fx-text-fill: #E8F4F8; -fx-font-size: 9.5px; -fx-font-weight: bold; -fx-font-family: 'Monospaced';"
                           GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="hostPortField" text="5000" styleClass="field-std"
                               GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                </GridPane>

                <!-- Jugadores esperados -->
                <HBox fx:id="expectedPlayersBox" spacing="12" alignment="CENTER_LEFT"
                      style="-fx-background-color: rgba(5,11,19,0.92);
                             -fx-background-radius: 10;
                             -fx-border-radius: 10;
                             -fx-border-color: rgba(0,229,255,0.10);
                             -fx-border-width: 1;
                             -fx-padding: 10 14;">
                    <Label text="JUGADORES ESPERADOS"
                           style="-fx-text-fill: #E8F4F8;
                                  -fx-font-size: 9.5px;
                                  -fx-font-weight: bold;
                                  -fx-font-family: 'Monospaced';"/>
                    <ChoiceBox fx:id="expectedPlayersChoice"
                               style="-fx-background-color: #080f18;
                                      -fx-border-color: #1a3450;
                                      -fx-border-radius: 8;
                                      -fx-background-radius: 8;
                                      -fx-font-family: 'Monospaced';
                                      -fx-font-size: 13px;"/>
                </HBox>

                <!-- Botón principal -->
                <Button text="ABRIR LOBBY"
                        onAction="#onAbrirLobby"
                        styleClass="lobby-btn"
                        maxWidth="Infinity"/>

                <!-- Error de validación -->
                <Label fx:id="errorLabel"
                       visible="false"
                       wrapText="true"
                       style="-fx-text-fill: #e05555;
                              -fx-font-size: 11px;
                              -fx-font-family: 'Monospaced';
                              -fx-background-color: rgba(220,40,40,0.07);
                              -fx-background-radius: 8;
                              -fx-padding: 6 10;
                              -fx-border-color: rgba(220,40,40,0.22);
                              -fx-border-radius: 8;
                              -fx-border-width: 1;"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
